{
  "name": "cufolio-navigator",
  "version": "1.0.0",
  "description": "Dynamic project navigator with real-time file watching",
  "main": "dist/server.js",
  "scripts": {
    "profiles": "tsx src/readProfiles.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --ignoreDeprecations 5.0",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "node dist/server.js",
    "serve": "npm run clean && npm run build && node dist/server.js",
    "type-check": "tsc --noEmit --ignoreDeprecations 5.0",
    "test:preview": "tsx src/preview/__tests__/ownership.test.ts"
  },
  "keywords": [
    "portfolio",
    "project-navigator",
    "file-watcher"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^10.3.10",
    "minimatch": "^9.0.3",
    "playwright": "^1.62.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
